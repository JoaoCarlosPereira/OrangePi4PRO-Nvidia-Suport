diff --git a/drivers/usb/host/ehci-sunxi.c b/drivers/usb/host/ehci-sunxi.c
index 2f3a6dd..6e5ed20 100644
--- a/drivers/usb/host/ehci-sunxi.c
+++ b/drivers/usb/host/ehci-sunxi.c
@@ -35,6 +35,8 @@
 
 static uintptr_t usb_vbase = SUNXI_EHCI0_BASE;
 unsigned int usb_drv_vbus_gpio = -1;
+/* Orange Pi 4 Pro: the Type-A ports' VBUS enable (PB7) is active-low. */
+static int usb_drv_vbus_active_low;
 
 typedef struct _ehci_config
 {
@@ -137,8 +139,12 @@ ulong config_usb_pin(int index)
 
 	if (index == 0)
 		usb_drv_vbus_gpio = sunxi_name_to_gpio(CONFIG_USB0_VBUS_PIN);
-	else if (index == 1)
+	else if (index == 1) {
 		usb_drv_vbus_gpio = sunxi_name_to_gpio(CONFIG_USB1_VBUS_PIN);
+#ifdef CONFIG_USB1_VBUS_ACTIVE_LOW
+		usb_drv_vbus_active_low = 1;
+#endif
+	}
 	else if (index == 2)
 		usb_drv_vbus_gpio = sunxi_name_to_gpio(CONFIG_USB2_VBUS_PIN);
 	else
@@ -165,7 +171,7 @@ void sunxi_set_vbus(int onoff)
 	if (usb_drv_vbus_gpio == -1)
 		return;
 
-	gpio_set_value(usb_drv_vbus_gpio, onoff);
+	gpio_set_value(usb_drv_vbus_gpio, usb_drv_vbus_active_low ? !onoff : onoff);
 	return;
 }
 
