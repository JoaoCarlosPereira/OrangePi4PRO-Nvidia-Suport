From: Orange Pi 4 Pro eGPU project <https://github.com/JoaoCarlosPereira/OrangePi4PRO-Nvidia-Suport>
Subject: [PATCH] pcie: sunxi: wait long enough for a Gen3 speed change and log the measured speed

Two problems in the vendor root-complex driver made every eGPU boot log
misleading link-speed information:

1. sunxi_pcie_host_read_speed() read LINK_CONTROL2_LINK_STATUS2 & 0xf,
   which is LnkCtl2.TargetLinkSpeed -- the value the driver itself had just
   written -- not LnkSta.CurrentLinkSpeed. "PCIe speed of GenN" therefore
   always echoed the request. Read LnkSta instead.

2. sunxi_pcie_host_wait_for_speed_change() gave DIRECT_SPEED_CHANGE only
   20 x usleep_range(100, 1000), i.e. 2-20 ms, to self-clear. A change to
   8 GT/s goes through Recovery.Equalization phases 0-3, each allowed tens
   of milliseconds by the spec, so a healthy Gen3 negotiation can time out
   here. On timeout the driver then printed "PCIe speed of Gen1"
   unconditionally. Wait up to ~500 ms, warn on timeout, and still report
   what the link actually negotiated.

Also give the NSI bandwidth-limit switch a default so an unexpected gen
value cannot leave `bwl` uninitialised.

Measured on Orange Pi 4 Pro with an RTX 3050 on the M.2 slot: with the
Gen1 overlay the link is already at Gen1 when the driver requests Gen1, so
the bit never self-clears and the old code printed "Speed change timeout"
on every successful boot. With the stock DT (max-link-speed = <3>) the link
trains to 8.0 GT/s x1 with EqualizationComplete+ and a clean AER counter.
---
--- a/bsp/drivers/pcie/pcie-sunxi.h	2026-09-07 03:08:56.824661407 -0300
+++ b/bsp/drivers/pcie/pcie-sunxi.h	2026-09-07 03:08:56.849652673 -0300
@@ -162,12 +162,21 @@
 #define PCIE_LINK_WIDTH_SPEED_CONTROL	0x80C
 #define PORT_LOGIC_SPEED_CHANGE		(0x1 << 17)
 #define LINK_CONTROL2_LINK_STATUS2	0xa0
+#define LINK_CONTROL_LINK_STATUS	0x80
+#define PCIE_LNKSTA_CLS_MASK		0xf	/* Current Link Speed, LnkSta[3:0] */
+#define PCIE_LNKSTA_SHIFT		16
 /* Parameters for the waiting for link up routine */
 #define LINK_WAIT_MAX_RETRIE		20
 #define LINK_WAIT_USLEEP_MIN		90000
 #define LINK_WAIT_USLEEP_MAX		100000
 #define SPEED_CHANGE_USLEEP_MIN		100
 #define SPEED_CHANGE_USLEEP_MAX		1000
+/*
+ * A Gen3 speed change walks Recovery.Equalization phases 0-3; the spec allows
+ * each phase tens of milliseconds. 20 x 1 ms was not enough and made every
+ * boot print a bogus "Speed change timeout".
+ */
+#define SPEED_CHANGE_MAX_RETRIES	500
 #define WAIT_ATU			1
 
 #define PCIE_MSI_ADDR_LO		0x820
--- a/bsp/drivers/pcie/pcie-sunxi-rc.c	2026-09-07 03:08:56.824613818 -0300
+++ b/bsp/drivers/pcie/pcie-sunxi-rc.c	2026-09-07 03:08:56.849902637 -0300
@@ -609,7 +609,7 @@
 	u32 tmp;
 	unsigned int retries;
 
-	for (retries = 0; retries < LINK_WAIT_MAX_RETRIE; retries++) {
+	for (retries = 0; retries < SPEED_CHANGE_MAX_RETRIES; retries++) {
 		tmp = sunxi_pcie_readl_dbi(pci, PCIE_LINK_WIDTH_SPEED_CONTROL);
 		if (!(tmp & PORT_LOGIC_SPEED_CHANGE))
 			return 0;
@@ -627,6 +627,7 @@
 	for (i = 0; i < MBUS_PMU_MAX; i++) {
 		if (strstr(get_name(i), "pcie")) {
 			switch (gen) {
+			default:
 			case 1:
 				bwl = 200;
 				break;
@@ -651,15 +652,17 @@
 {
 	int val, gen;
 
-	sunxi_pcie_dbi_ro_wr_en(pci);
-	val = sunxi_pcie_readl_dbi(pci, LINK_CONTROL2_LINK_STATUS2);
-	gen = val & 0xf;
+	/*
+	 * The negotiated speed is LnkSta.CurrentLinkSpeed. LnkCtl2[3:0] is the
+	 * *target* we just programmed, so reading it back only echoes the request.
+	 */
+	val = sunxi_pcie_readl_dbi(pci, LINK_CONTROL_LINK_STATUS);
+	gen = (val >> PCIE_LNKSTA_SHIFT) & PCIE_LNKSTA_CLS_MASK;
 
 	sunxi_info(pci->dev, "PCIe speed of Gen%d\n", gen);
 	sunxi_pcie_host_change_nsi_port_bwl(pci, gen);
 
-	sunxi_pcie_dbi_ro_wr_dis(pci);
-	return 0;
+	return gen;
 }
 
 int sunxi_pcie_host_speed_change(struct sunxi_pcie *pci, int gen)
@@ -682,12 +685,11 @@
 	sunxi_pcie_writel_dbi(pci, PCIE_LINK_WIDTH_SPEED_CONTROL, val);
 
 	ret = sunxi_pcie_host_wait_for_speed_change(pci);
-	if (!ret) {
-		sunxi_info(pci->dev, "PCIe speed of Gen%d\n", gen);
-		sunxi_pcie_host_change_nsi_port_bwl(pci, gen);
-	}
-	else
-		sunxi_info(pci->dev, "PCIe speed of Gen1\n");
+	if (ret)
+		sunxi_warn(pci->dev, "speed change to Gen%d did not complete, reporting what the link negotiated\n", gen);
+
+	/* Always report the measured speed, never the requested one. */
+	sunxi_pcie_host_read_speed(pci);
 
 	sunxi_pcie_dbi_ro_wr_dis(pci);
 	return 0;
