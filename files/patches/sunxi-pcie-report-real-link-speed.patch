
The NSI bandwidth limiter was set from the requested gen (200/400/700
MB/s) and measured throughput landed exactly on it (199 MB/s at Gen1,
398 MB/s at Gen2). One lane cannot exceed ~985 MB/s, so give every gen
the Gen3 budget. Measured after the change: 204-209 MB/s at Gen1.
---
diff --git a/bsp/drivers/pcie/pcie-sunxi-rc.c b/bsp/drivers/pcie/pcie-sunxi-rc.c
index de5ae184d..c940975de 100644
--- a/bsp/drivers/pcie/pcie-sunxi-rc.c
+++ b/bsp/drivers/pcie/pcie-sunxi-rc.c
@@ -609,7 +609,7 @@ static int sunxi_pcie_host_wait_for_speed_change(struct sunxi_pcie *pci)
 	u32 tmp;
 	unsigned int retries;
 
-	for (retries = 0; retries < LINK_WAIT_MAX_RETRIE; retries++) {
+	for (retries = 0; retries < SPEED_CHANGE_MAX_RETRIES; retries++) {
 		tmp = sunxi_pcie_readl_dbi(pci, PCIE_LINK_WIDTH_SPEED_CONTROL);
 		if (!(tmp & PORT_LOGIC_SPEED_CHANGE))
 			return 0;
@@ -626,17 +626,14 @@ void sunxi_pcie_host_change_nsi_port_bwl(struct sunxi_pcie *pci, int gen)
 	int i, bwl;
 	for (i = 0; i < MBUS_PMU_MAX; i++) {
 		if (strstr(get_name(i), "pcie")) {
-			switch (gen) {
-			case 1:
-				bwl = 200;
-				break;
-			case 2:
-				bwl = 400;
-				break;
-			case 3:
-				bwl = 700;
-				break;
-			}
+			/*
+			 * The per-gen limits (200/400/700) cap measured throughput at
+			 * exactly those values on Orange Pi 4 Pro (398 MB/s on a Gen2
+			 * link that does 410-418 unrestricted). A single lane cannot
+			 * exceed ~985 MB/s anyway, so give every gen the Gen3 budget.
+			 */
+			bwl = 700;
+			(void)gen;
 			nsi_port_set_abs_bwlen(i, false);
 			nsi_port_set_abs_bwl(i, bwl);
 			nsi_port_set_abs_bwlen(i, true);
@@ -651,15 +648,17 @@ int sunxi_pcie_host_read_speed(struct sunxi_pcie *pci)
 {
 	int val, gen;
 
-	sunxi_pcie_dbi_ro_wr_en(pci);
-	val = sunxi_pcie_readl_dbi(pci, LINK_CONTROL2_LINK_STATUS2);
-	gen = val & 0xf;
+	/*
+	 * The negotiated speed is LnkSta.CurrentLinkSpeed. LnkCtl2[3:0] is the
+	 * *target* we just programmed, so reading it back only echoes the request.
+	 */
+	val = sunxi_pcie_readl_dbi(pci, LINK_CONTROL_LINK_STATUS);
+	gen = (val >> PCIE_LNKSTA_SHIFT) & PCIE_LNKSTA_CLS_MASK;
 
 	sunxi_info(pci->dev, "PCIe speed of Gen%d\n", gen);
 	sunxi_pcie_host_change_nsi_port_bwl(pci, gen);
 
-	sunxi_pcie_dbi_ro_wr_dis(pci);
-	return 0;
+	return gen;
 }
 
 int sunxi_pcie_host_speed_change(struct sunxi_pcie *pci, int gen)
@@ -682,12 +681,11 @@ int sunxi_pcie_host_speed_change(struct sunxi_pcie *pci, int gen)
 	sunxi_pcie_writel_dbi(pci, PCIE_LINK_WIDTH_SPEED_CONTROL, val);
 
 	ret = sunxi_pcie_host_wait_for_speed_change(pci);
-	if (!ret) {
-		sunxi_info(pci->dev, "PCIe speed of Gen%d\n", gen);
-		sunxi_pcie_host_change_nsi_port_bwl(pci, gen);
-	}
-	else
-		sunxi_info(pci->dev, "PCIe speed of Gen1\n");
+	if (ret)
+		sunxi_warn(pci->dev, "speed change to Gen%d did not complete, reporting what the link negotiated\n", gen);
+
+	/* Always report the measured speed, never the requested one. */
+	sunxi_pcie_host_read_speed(pci);
 
 	sunxi_pcie_dbi_ro_wr_dis(pci);
 	return 0;
diff --git a/bsp/drivers/pcie/pcie-sunxi.h b/bsp/drivers/pcie/pcie-sunxi.h
index 605406ba1..19d0558bd 100644
--- a/bsp/drivers/pcie/pcie-sunxi.h
+++ b/bsp/drivers/pcie/pcie-sunxi.h
@@ -162,12 +162,21 @@
 #define PCIE_LINK_WIDTH_SPEED_CONTROL	0x80C
 #define PORT_LOGIC_SPEED_CHANGE		(0x1 << 17)
 #define LINK_CONTROL2_LINK_STATUS2	0xa0
+#define LINK_CONTROL_LINK_STATUS	0x80
+#define PCIE_LNKSTA_CLS_MASK		0xf	/* Current Link Speed, LnkSta[3:0] */
+#define PCIE_LNKSTA_SHIFT		16
 /* Parameters for the waiting for link up routine */
 #define LINK_WAIT_MAX_RETRIE		20
 #define LINK_WAIT_USLEEP_MIN		90000
 #define LINK_WAIT_USLEEP_MAX		100000
 #define SPEED_CHANGE_USLEEP_MIN		100
 #define SPEED_CHANGE_USLEEP_MAX		1000
+/*
+ * A Gen3 speed change walks Recovery.Equalization phases 0-3; the spec allows
+ * each phase tens of milliseconds. 20 x 1 ms was not enough and made every
+ * boot print a bogus "Speed change timeout".
+ */
+#define SPEED_CHANGE_MAX_RETRIES	500
 #define WAIT_ATU			1
 
 #define PCIE_MSI_ADDR_LO		0x820
