#!/bin/bash
# First-boot menu on tty1: keep running from the boot medium, or move the system to
# a connected disk (USB 3 SSD via USB-C, NVMe) while the medium keeps /boot.
# Default (no answer in 60 s): keep running from the boot medium.
set -u
FLAG=/var/lib/egpu/firstboot-done; mkdir -p /var/lib/egpu
# the vendor first-run resize reboots once; wait for the boot after that
systemctl is-enabled orangepi-resize-filesystem.service >/dev/null 2>&1 && exit 0
udevadm settle 2>/dev/null; sleep 3
mapfile -t CANDS < <(/usr/local/sbin/egpu-install-to-disk --list 2>/dev/null | awk -F'|' 'NR>2 && /^  \/dev/ {gsub(/^ +/,"",$1); print}')
if [ ${#CANDS[@]} -eq 0 ]; then touch $FLAG; exit 0; fi   # nothing to offer, do not nag
BOOT=$(/usr/local/sbin/egpu-install-to-disk --list 2>/dev/null | sed -n 's/^boot medium: \(\/dev\/[a-z0-9]*\).*/\1/p')
ITEMS=(keep "Keep running from $BOOT (default)")
for c in "${CANDS[@]}"; do IFS='|' read -r dev size tran model <<<"$c"; ITEMS+=("$dev" "Install the system to $dev  $size $tran $model  (ERASES IT)"); done
ITEMS+=(later "Ask again on the next boot")
CHOICE=$(whiptail --title "Orange Pi 4 Pro eGPU image" --timeout 60 --default-item keep \
    --menu "The ROM boots only from microSD/USB 2.0. Linux can run the system from a faster disk\nwhile $BOOT keeps /boot. Choose:" 20 78 8 "${ITEMS[@]}" 3>&1 1>&2 2>&3) || CHOICE=keep
case "$CHOICE" in
    later) exit 0;;
    keep|"") touch $FLAG; exit 0;;
    /dev/*)
        if whiptail --title "Confirm" --yesno "ALL DATA ON $CHOICE WILL BE ERASED.\n\nThe system will be copied there and the board reboots into it.\n$BOOT stays as boot medium and fallback.\n\nContinue?" 14 70; then
            clear; /usr/local/sbin/egpu-install-to-disk --yes "$CHOICE" || { echo; echo "install failed; press Enter"; read -r _; }
        fi
        touch $FLAG;;
esac
exit 0
