#!/bin/sh
# Snapshot of the PCIe link between the A733 root port and the GPU.
#
# Read-only. Prints, for both link partners, the advertised maximum (LnkCap),
# the negotiated speed/width (LnkSta), the requested target (LnkCtl2), the
# Gen3 equalization result bits (LnkSta2), the AER correctable-error status,
# and -- from the controller's DBI space via /dev/mem -- the DesignWare Gen3
# equalization registers and the LTSSM state. Run it before and after every
# change to the link so the results are comparable.
#
# Register offsets: DBI base 0x06000000 (PCIe capability at 0x70),
# application registers at 0x06400000. See docs/PCIE-LINK-SPEED.md.
set -eu

RP=0000:00:00.0
EP=0000:01:00.0
SYS=/sys/bus/pci/devices

[ "$(id -u)" -eq 0 ] || { echo "run as root"; exit 1; }
[ -e $SYS/$RP ] || { echo "no root port at $RP -- PCIe controller not bound"; exit 1; }

show_sysfs() {
    d=$1
    printf '  %-8s speed=%-16s width=x%-3s max=%s x%s\n' "$d" \
        "$(cat $SYS/$d/current_link_speed 2>/dev/null || echo ?)" \
        "$(cat $SYS/$d/current_link_width 2>/dev/null || echo ?)" \
        "$(cat $SYS/$d/max_link_speed 2>/dev/null || echo ?)" \
        "$(cat $SYS/$d/max_link_width 2>/dev/null || echo ?)"
}

echo "== sysfs (measured by the kernel from LnkSta)"
show_sysfs $RP
[ -e $SYS/$EP ] && show_sysfs $EP || echo "  $EP  NOT ENUMERATED"

echo
echo "== lspci (LnkCap = advertised, LnkSta = negotiated, LnkSta2 = equalization)"
for d in $RP $EP; do
    [ -e $SYS/$d ] || continue
    echo "  -- $d"
    lspci -vv -s "$d" 2>/dev/null | grep -E "LnkCap:|LnkSta:|LnkCtl2:|LnkSta2:|LnkCtl:|CESta:|DevSta:" | sed 's/^[[:space:]]*/     /'
done

echo
echo "== root port PCIe capability, raw (setpci)"
for r in "LnkCap CAP_EXP+0x0c.L" "LnkCtl/LnkSta CAP_EXP+0x10.L" "LnkCap2 CAP_EXP+0x2c.L" "LnkCtl2/LnkSta2 CAP_EXP+0x30.L"; do
    name=${r% *}; reg=${r#* }
    printf '  %-16s %s = %s\n' "$name" "$reg" "$(setpci -s 00:00.0 $reg 2>/dev/null || echo ?)"
done

echo
echo "== DesignWare DBI registers (via /dev/mem)"
python3 - <<'PY'
import mmap, os, struct
DBI, APP = 0x06000000, 0x06400000
LTSSM = {0x00:"DETECT_QUIET",0x01:"DETECT_ACT",0x02:"POLL_ACTIVE",0x03:"POLL_COMPLIANCE",
 0x04:"POLL_CONFIG",0x05:"PRE_DETECT_QUIET",0x06:"DETECT_WAIT",0x07:"CFG_LINKWD_START",
 0x08:"CFG_LINKWD_ACEPT",0x09:"CFG_LANENUM_WAIT",0x0a:"CFG_LANENUM_ACEPT",0x0b:"CFG_COMPLETE",
 0x0c:"CFG_IDLE",0x0d:"RCVRY_LOCK",0x0e:"RCVRY_SPEED",0x0f:"RCVRY_RCVRCFG",0x10:"RCVRY_IDLE",
 0x11:"L0",0x12:"L0S",0x13:"L123_SEND_EIDLE",0x14:"L1_IDLE",0x15:"L2_IDLE",0x16:"L2_WAKE",
 0x17:"DISABLED_ENTRY",0x18:"DISABLED_IDLE",0x19:"DISABLED",0x1a:"LPBK_ENTRY",0x1b:"LPBK_ACTIVE",
 0x1c:"LPBK_EXIT",0x1d:"LPBK_EXIT_TIMEOUT",0x1e:"HOT_RESET_ENTRY",0x1f:"HOT_RESET",
 0x20:"RCVRY_EQ0",0x21:"RCVRY_EQ1",0x22:"RCVRY_EQ2",0x23:"RCVRY_EQ3"}
try:
    fd = os.open("/dev/mem", os.O_RDONLY | os.O_SYNC)
except OSError as e:
    print("  /dev/mem not readable:", e); raise SystemExit
def rd(base, off):
    m = mmap.mmap(fd, 0x1000, mmap.MAP_SHARED, mmap.PROT_READ, offset=base + (off & ~0xfff))
    v = struct.unpack_from("<I", m, off & 0xfff)[0]; m.close(); return v
v = rd(DBI, 0x80c);  print(f"  0x80c LINK_WIDTH_SPEED_CTRL = 0x{v:08x}  direct_speed_change={(v>>17)&1} link_width_field={(v>>8)&0x3f} n_fts={v&0xff}")
v = rd(DBI, 0x890);  print(f"  0x890 GEN3_RELATED_OFF      = 0x{v:08x}  gen3_eq_disable={(v>>16)&1} rate_shadow_sel={(v>>24)&3} zrxdc_noncompl={v&1}")
v = rd(DBI, 0x8a8);  print(f"  0x8a8 GEN3_EQ_CONTROL       = 0x{v:08x}  fb_mode={v&0xf} pset_req_vec=0x{(v>>8)&0xffff:04x}")
v = rd(DBI, 0x8ac);  print(f"  0x8ac GEN3_EQ_FB_MODE_DIR   = 0x{v:08x}")
v = rd(DBI, 0x8bc);  print(f"  0x8bc MISC_CONTROL_1        = 0x{v:08x}  dbi_ro_wr_en={v&1}")
v = rd(DBI, 0x728);  st = v & 0x3f
print(f"  0x728 PL_DEBUG0             = 0x{v:08x}  LTSSM=0x{st:02x} {LTSSM.get(st,'?')}")
v = rd(APP, 0xe0c);  print(f"  app 0xe0c LINK_STAT         = 0x{v:08x}  smlh_link_up={v&1} rdlh_link_up={(v>>1)&1}")
v = rd(APP, 0x1350); print(f"  app 0x1350 SII_GEN3_EQ      = 0x{v:08x}  in_recovery_eq={v&1}")
PY

echo
echo "== kernel link messages this boot"
dmesg 2>/dev/null | grep -E "pcie-rc|available PCIe bandwidth|Speed change|PCIe speed" | tail -12 | sed 's/^/  /'
