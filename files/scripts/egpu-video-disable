#!/bin/sh
# Sem argumentos: forca o HDMI do Orange Pi, permanentemente.
# Com --rollback (watchdog/OnFailure): desfaz so neste boot; o egpu-video-apply
# volta a decidir no proximo.
set -eu

ROLLBACK=0
case "${1:-}" in
    --rollback|--auto) ROLLBACK=1 ;;   # --auto mantido como alias antigo
esac

MUDOU=0
if [ -f /etc/X11/xorg.conf ] && grep -q egpu-layout /etc/X11/xorg.conf; then
    rm -f /etc/X11/xorg.conf
    MUDOU=1
fi
# O desktop volta ao PowerVR: o loader tambem volta a ordem de fabrica.
[ -x /usr/local/sbin/egpu-gl-profile ] && /usr/local/sbin/egpu-gl-profile integrada

if [ "$ROLLBACK" -eq 0 ]; then
    sed -i 's/^EGPU_VIDEO=.*/EGPU_VIDEO=no/' /etc/default/egpu-video
    if [ "$(cat /sys/class/graphics/fb0/name 2>/dev/null)" = "nvidia-drmdrmfb" ]; then
        rmmod nvidia_drm 2>/dev/null || true
        modprobe nvidia_drm modeset=1 fbdev=0 2>/dev/null || true
    fi
    echo "Fixado no HDMI do Orange Pi. Aplique com: systemctl restart display-manager"
    exit 0
fi

[ "$MUDOU" -eq 0 ] && exit 0
logger -t egpu-video "rollback neste boot; o proximo volta a decidir sozinho"
# display-manager.service e o alias para o DM realmente em uso (lightdm,
# gdm3, sddm...). Nomear um deles sobe um segundo DM em paralelo.
systemctl reset-failed display-manager.service || true
systemctl restart display-manager.service || true
